[[15,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Position the vehicle on the ramp</p><p>1. Undo the nuts (1a) and remove the rear suspension anti-roll bar joint (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/125004802.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>1. Place the front suspension anti-roll bar joints (1a) back in their housings and fix it tightening nuts (1b) and (1c) to the recommended torque.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/125000866.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>Ø</p></th><th colspan=\"1\"><p>Value</p><p>(daNm)</p></th></tr><tr><td><p>1b</p></td><td><p>Nut</p></td><td><p>FRONT ANTI-ROLL BAR JOINTS</p></td><td><p>M10</p></td><td colspan=\"1\"><p>(Front shock absorber fork side) 4.1 ÷ 5.0</p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/125000866.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>Ø</p></th><th colspan=\"1\"><p>Value</p><p>(daNm)</p></th></tr><tr><td><p>1c</p></td><td><p>Nut</p></td><td><p>FRONT ANTI-ROLL BAR JOINTS</p></td><td><p>M10</p></td><td colspan=\"1\"><p>(Anti-roll bar side) 4.5 ÷ 5.5</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/125004803.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,1,0,"<p>Remove the car from the ramps.</p>"]]